{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Build Script",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [],
			"type": "shell",
			"command": "${workspaceFolder}/script/build",
			"args": ["time:all"]
		},
		{
			"label": "Run Checks (npm)",
			"type": "npm",
			"script": "cicd:build"
		},
		{
			"label": "Run Tests (npm)",
			"type": "npm",
			"script": "test"
		},
		{
			"label": "Run CICD Validations",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [],
			"dependsOrder": "sequence",
			"dependsOn": ["Run Checks (npm)", "Run Tests (npm)"]
		}
	]
}
