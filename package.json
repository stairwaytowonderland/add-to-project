{
	"name": "add-to-github-project",
	"description": "Automatically adds issues and PRs to a GitHub project",
	"version": "1.11.1",
	"author": "",
	"type": "module",
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^6.0.0",
		"@octokit/plugin-paginate-rest": "^14.0.0",
		"@octokit/request": "^10.0.3",
		"@octokit/request-error": "^7.1.1"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">= 8.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@github/prettier-config": "^0.0.6",
		"@jest/globals": "^30.2.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.2.0",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.0",
		"@vercel/ncc": "^0.45.0",
		"concurrently": "^10.0.5",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-github": "^6.0.0",
		"eslint-plugin-jest": "^29.16.0",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.4.0",
		"jest": "^30.2.0",
		"make-coverage-badge": "^1.2.0",
		"prettier": "3.9.6",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.5",
		"rollup-plugin-license": "^3.7.1",
		"semantic-release": "^25.0.8",
		"semantic-release-export-data": "^1.2.0",
		"ts-jest": "^29.4.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"resolutions": {
		"ip-address": "10.31.0"
	},
	"overrides": {
		"@actions/github": {
			"undici": "^6.28.0"
		},
		"@actions/http-client": {
			"undici": "^6.28.0"
		},
		"js-yaml": "^4.3.1",
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^3.15.1"
		}
	},
	"keywords": [
		"github",
		"actions",
		"projects"
	],
	"license": "MIT",
	"exports": {
		".": "./dist/index.js"
	},
	"private": true,
	"homepage": "https://github.com/stairwaytowonderland/add-to-project",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stairwaytowonderland/add-to-project.git"
	},
	"bugs": {
		"url": "https://github.com/stairwaytowonderland/add-to-project/issues"
	},
	"scripts": {
		"clean": "rm -rf node_modules package-lock.json && npm cache clean --force",
		"build": "npm run fix:format && npm run check && npm run build:compile && npm run build:package",
		"build:compile": "tsc",
		"build:package": "npm run fix:regex && npm run package",
		"check": "concurrently -n check: -c red,green,blue -g npm:check:*",
		"check:build": "tsc --noEmit",
		"check:test": "tsc --noEmit --project tsconfig.test.json",
		"check:format": "prettier --check .",
		"check:lint": "eslint .",
		"coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
		"fix": "concurrently -n fix: -c cyan,yellow,magenta -g npm:fix:*",
		"fix:format": "prettier --write .",
		"fix:lint": "eslint --fix .",
		"fix:regex": "node fix-regex.cjs",
		"package": "rimraf ./dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "npm run package -- --watch",
		"format-check": "npm run check:format",
		"lint": "npm run check:lint",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage",
		"preinstall": "npx npm-force-resolutions",
		"postinstall": "npm run fix:regex",
		"all": "npm run fix && npm run build && npm test && npm run coverage"
	}
}
