{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": ".",
		"noEmit": true,
		"types": ["jest", "node"],
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["src", "__fixtures__", "__tests__"],
	"exclude": ["coverage", "dist", "node_modules"]
}
